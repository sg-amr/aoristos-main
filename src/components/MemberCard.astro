---
interface Props {
  name: string;
  role: string;
  specialties: string[];
  icon: string;
}

const { name, role, specialties, icon } = Astro.props;
---

<div class="flex flex-col items-center p-8 bg-white border border-gray-100 shadow-sm hover:shadow-lg transition-all duration-300">
  <div class="w-32 h-32 mb-6 bg-gray-50 rounded-full flex items-center justify-center p-6 border-2 border-transparent hover:border-[var(--color-aoristos-green)] transition-colors overflow-hidden">
    <img src={icon} alt={`${name} abstract symbol`} class="w-full h-full object-contain opacity-80" />
  </div>

  <h3 class="text-xl font-bold text-gray-900 mb-1">{name}</h3>

  {role && (
    <p class="text-xs font-semibold text-gray-400 tracking-wider uppercase mb-4">
      {role}
    </p>
  )}
  {!role && <div class="mb-4 h-[18px]"></div>}

  <div class="flex flex-wrap justify-center gap-2 mt-auto">
    {specialties.map(spec => (
      <span class="px-3 py-1 bg-[var(--color-aoristos-green)]/10 text-[var(--color-aoristos-green)] text-xs font-medium rounded-sm">
        {spec}
      </span>
    ))}
  </div>
</div>
