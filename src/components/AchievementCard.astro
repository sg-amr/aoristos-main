---
interface Props {
  title: string;
  description: string;
  category: string;
  link?: string;
}

const { title, description, category, link } = Astro.props;
---

<div class="group relative flex flex-col justify-between p-6 bg-white border border-gray-100 hover:border-gray-200 transition-all duration-300 shadow-sm hover:shadow-md">
  <div>
    <div class="mb-4 inline-block px-3 py-1 text-xs font-semibold tracking-wider text-[var(--color-aoristos-green)] border border-[var(--color-aoristos-green)]/30 rounded-full">
      {category}
    </div>
    <h3 class="text-lg font-bold mb-2 text-gray-900 group-hover:text-[var(--color-aoristos-green)] transition-colors line-clamp-2">
      {title}
    </h3>
    <p class="text-sm text-gray-500 line-clamp-3">
      {description}
    </p>
  </div>

  {link && (
    <div class="mt-6 pt-4 border-t border-gray-50">
      <a href={link} target="_blank" rel="noopener noreferrer" class="inline-flex items-center text-sm font-medium text-gray-400 hover:text-[var(--color-aoristos-green)] transition-colors">
        Read Article
        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 ml-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
        </svg>
      </a>
    </div>
  )}
</div>
