  <style>
    .phase-school { animation: show-school 12s infinite; }
    .phase-trans1 { animation: show-trans1 12s infinite; }
    .phase-trans-teacher-leave { animation: show-teacher-leave 12s infinite; }
    .phase-wb { animation: show-wb 12s infinite; }
    .phase-trans2 { animation: show-trans2 12s infinite; }
    .phase-home { animation: show-home 12s infinite; }
    .phase-trans-teacher-enter { animation: show-teacher-enter 12s infinite; }
    .phase-trans3 { animation: show-trans3 12s infinite; }

    @keyframes show-school {
      0%, 20.83% { opacity: 1; }
      20.84%, 100% { opacity: 0; }
    }
    @keyframes show-trans1 {
      0%, 20.83% { opacity: 0; }
      20.84%, 29.16% { opacity: 1; }
      29.17%, 100% { opacity: 0; }
    }
    @keyframes show-teacher-leave {
      0%, 20.83% { opacity: 0; }
      20.84%, 29.16% { opacity: 1; }
      29.17%, 100% { opacity: 0; }
    }
    @keyframes show-wb {
      0%, 29.16% { opacity: 0; }
      29.17%, 62.50% { opacity: 1; }
      62.51%, 100% { opacity: 0; }
    }
    @keyframes show-trans2 {
      0%, 62.50% { opacity: 0; }
      62.51%, 70.83% { opacity: 1; }
      70.84%, 100% { opacity: 0; }
    }
    @keyframes show-home {
      0%, 70.83% { opacity: 0; }
      70.84%, 95.83% { opacity: 1; }
      95.84%, 100% { opacity: 0; }
    }
    @keyframes show-teacher-enter {
      0%, 91.66% { opacity: 0; }
      91.67%, 95.83% { opacity: 1; }
      95.84%, 100% { opacity: 0; }
    }
    @keyframes show-trans3 {
      0%, 95.83% { opacity: 0; }
      95.84%, 100% { opacity: 1; }
    }
  </style>

  <script>

    // --- Magnetic Typography Effect ---
    const magneticText = document.getElementById('magnetic-text');
    if (magneticText) {
      const letters = magneticText.querySelectorAll('span');
      const maxDistance = 300; // How close mouse needs to be to pull letter
      const pullStrength = 0.15; // How much it pulls (lower = less movement)

      document.addEventListener('mousemove', (e) => {
        const mouseX = e.clientX;
        const mouseY = e.clientY;

        letters.forEach((letter) => {
          const rect = letter.getBoundingClientRect();
          // Center of the letter
          const letterX = rect.left + rect.width / 2;
          const letterY = rect.top + rect.height / 2;

          const distanceX = mouseX - letterX;
          const distanceY = mouseY - letterY;
          const distance = Math.sqrt(distanceX * distanceX + distanceY * distanceY);

          if (distance < maxDistance) {
            // Calculate pull: closer = stronger pull
            const force = (maxDistance - distance) / maxDistance;
            const moveX = distanceX * force * pullStrength;
            const moveY = distanceY * force * pullStrength;

            letter.style.transform = `translate(${moveX}px, ${moveY}px)`;
          } else {
            // Reset position if mouse is far
            letter.style.transform = `translate(0px, 0px)`;
          }
        });
      });

      // Reset when mouse leaves window
      document.addEventListener('mouseleave', () => {
        letters.forEach((letter) => {
          letter.style.transform = `translate(0px, 0px)`;
        });
      });
    }

    // --- Page Load Animation ---
    document.addEventListener("DOMContentLoaded", () => {
      const pageContent = document.getElementById('page-content');
      if (pageContent) {
        // Small delay to ensure CSS is ready
        setTimeout(() => {
          pageContent.classList.remove('opacity-0');
        }, 50);
      }
    });


    // --- Cinematic Scroll Animations ---
    const handleScroll = () => {
      const scrollY = window.scrollY;
      const windowHeight = window.innerHeight;

      // 1. Text Fill "共鳴"
      const textFillPhase = Math.min(Math.max(scrollY / (windowHeight * 0.5), 0), 1);
      const textFillElement = document.getElementById('text-fill');
      if (textFillElement) {
        textFillElement.style.width = `${textFillPhase * 100}%`;
      }


      // 2. Transition Box Expansion (Github-like curve)
      const expandStart = windowHeight * 0.8;
      const expandEnd = windowHeight * 1.5; // Perfectly aligns with the 200vh container (100vh static + 100vh scroll)
      const expandPhase = Math.min(Math.max((scrollY - expandStart) / (expandEnd - expandStart), 0), 1);

      const transitionBg = document.getElementById('transition-bg');
      const scaleContainer = document.getElementById('philosophy-scale-container');

      if (transitionBg) {
        const width = 10 + (90 * expandPhase);
        const height = 100 * expandPhase;
        const radius = 50 * (1 - expandPhase);

        transitionBg.style.width = `${width}%`;
        transitionBg.style.height = `${height}%`;
        transitionBg.style.borderTopLeftRadius = `${radius}%`;
        transitionBg.style.borderTopRightRadius = `${radius}%`;

        // Remove border at the very end for a clean transition to next section
        if (expandPhase === 1) {
          transitionBg.classList.remove('border-t-2', 'shadow-[0_-10px_40px_rgba(132,204,22,0.15)]');
        } else {
          transitionBg.classList.add('border-t-2', 'shadow-[0_-10px_40px_rgba(132,204,22,0.15)]');
        }
      }

      if (scaleContainer) {
        // Scale from 0.1 to 1.0 synchronously with the box expansion
        // This keeps the text layout fixed while making it visually grow
        const scale = 0.1 + (0.9 * expandPhase);
        scaleContainer.style.transform = `scale(${scale})`;
      }

      // 3. Fade Out Hero & Fade In Philosophy

      const heroContent = document.getElementById('hero-content');
      const philosophyContent = document.getElementById('philosophy-content');

      if (heroContent) {
        heroContent.style.opacity = `${1 - (expandPhase * 2)}`;
      }
      if (philosophyContent) {
        if (expandPhase > 0.8) {
          philosophyContent.style.opacity = "1";
        } else {
          philosophyContent.style.opacity = "0";
        }
      }
    };

    window.addEventListener("scroll", handleScroll);
    // Initialize state in case of mid-page reload
    document.addEventListener("DOMContentLoaded", handleScroll);
  </script>

</BaseLayout>
